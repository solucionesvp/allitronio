"use client";

// ── /productos/domina-google — Página informativa (evergreen) ───────────────
// Nombre público del servicio interno "local" (antes "MAPS 2.0" — no usar ese
// nombre de cara al usuario). Reestructurada 21-sep-2026 (instrucción de
// Lups): misma arquitectura visual e identidad que la landing de campaña
// (/productos/domina-google/lanzamiento) — mismas fotos (PRODUCT_LOCAL_LAUNCH),
// misma paleta clara aislada, mismo criterio de oscuro-solo-en-hero-y-cta-final.
// Esta página vive bajo el nav completo del sitio (no es landing de tráfico
// pagado) y su función es explicar el producto: qué es, por qué es necesario,
// qué hace, por qué funciona, y por qué debe ir ANTES que invertir en redes
// sociales. Todos los CTA dicen "ADQUIRIR PRODUCTO" y llevan a la landing de
// campaña — ahí vive el formulario/WhatsApp real, no aquí.

import Link from "next/link";
import { type CSSProperties, useState } from "react";
import { motion } from "framer-motion";
import {
  ArrowUpRight,
  Zap,
  LayoutTemplate,
  Search,
  MapPin,
  Link2,
  CheckCircle2,
  MessageCircle,
  Upload,
  ShieldCheck,
  X,
  Check,
  Megaphone,
  Compass,
  Target,
} from "lucide-react";
import Navbar from "@/components/layout/Navbar";
import Footer from "@/components/layout/Footer";
import { LaunchImage } from "@/components/media/LaunchImage";
import { PRODUCT_LOCAL, PRODUCT_LOCAL_LAUNCH as IMG } from "@/config/assets";
import { DOMINA_GOOGLE_LIGHT, DOMINA_GOOGLE_TOKENS } from "@/config/productTheme";
import { LOCAL_METHODOLOGY } from "@/data/solutions";
import {
  DG_INCLUDES,
  DG_EXCLUDES,
  DG_IDEAL_CLIENT,
  DG_REQUIREMENTS,
} from "@/data/dominaGoogleContent";

const EASE: [number, number, number, number] = [0.25, 0.46, 0.45, 0.94];
const ACCENT = DOMINA_GOOGLE_TOKENS.accent;
const GRADIENT = DOMINA_GOOGLE_TOKENS.gradient;
const L = DOMINA_GOOGLE_LIGHT;

// Variables de la paleta clara — solo viven dentro de <main> de esta página
// (idéntico patrón a la landing de lanzamiento — no toca el resto del sitio).
const LIGHT_VARS = {
  "--dg-bg": L.bg,
  "--dg-bg-alt": L.bgAlt,
  "--dg-card": L.card,
  "--dg-ink": L.ink,
  "--dg-muted": L.muted,
  "--dg-line": L.line,
  "--dg-accent-text": L.accentText,
} as CSSProperties;

const H2 = "font-display font-black leading-[1.05] tracking-tight text-[var(--dg-ink)]";
const BODY = "font-body text-[0.88rem] leading-[1.8] text-[var(--dg-muted)]";
const EYEBROW = "mb-5 block font-display text-[0.52rem] font-bold tracking-[0.44em] text-[var(--dg-muted)]";

const INCLUDE_ICONS = [Zap, LayoutTemplate, Search, MapPin, Link2, CheckCircle2, MessageCircle, Upload, ShieldCheck];
const PHASE_BASES = [IMG.fase1, IMG.fase2, IMG.fase3, IMG.fase4] as const;
// Mientras no exista la foto nueva de cada fase, se usa la de la evergreen anterior.
const PHASE_FALLBACKS = [PRODUCT_LOCAL.hero, PRODUCT_LOCAL.analysis, PRODUCT_LOCAL.build, PRODUCT_LOCAL.result] as const;

function reveal(delay = 0) {
  return {
    initial: { opacity: 0, y: 16 },
    whileInView: { opacity: 1, y: 0 },
    viewport: { once: true, margin: "-60px" as const },
    transition: { duration: 0.6, delay, ease: EASE },
  };
}

function CtaLink({ label = "ADQUIRIR PRODUCTO", large = false }: { label?: string; large?: boolean }) {
  return (
    <Link
      href="/productos/domina-google/lanzamiento"
      className={`inline-flex items-center gap-2 rounded-sm font-display font-bold text-white transition-transform duration-300 hover:scale-[1.02] ${
        large ? "px-8 py-4 text-[0.68rem] tracking-[0.2em]" : "px-6 py-3 text-[0.62rem] tracking-[0.2em] sm:px-7 sm:py-3.5"
      }`}
      style={{ background: GRADIENT }}
    >
      {label}
      <ArrowUpRight className="h-3.5 w-3.5" strokeWidth={2.5} />
    </Link>
  );
}

// ── El argumento "antes que redes sociales" — el enemigo es la invisibilidad,
// no la competencia. Gastar en redes sin poder ser encontrado en Google es
// llenar de gente un lugar que todavía no existe en el mapa. ──────────────
const BEFORE_SOCIAL_POINTS = [
  {
    icon: Compass,
    title: "Las redes atraen. Google decide.",
    text: "Un anuncio o un video pueden hacer que alguien se entere de ti. Pero cuando esa persona ya está lista para comprar, no vuelve al feed — busca en Google. Si ahí no apareces, el trabajo de las redes se pierde en el último paso.",
  },
  {
    icon: Target,
    title: "Primero existir, después amplificar.",
    text: "Invertir en contenido o pauta antes de tener presencia real en Google es pagar para que más gente llegue a un negocio que, en el momento de decidir, es difícil de encontrar o de confirmar como real.",
  },
  {
    icon: Megaphone,
    title: "Por eso esto no incluye redes.",
    text: "Domina Google resuelve un solo problema, a propósito: que te encuentren y te contacten. El manejo de redes sociales es una decisión aparte, que tiene más sentido una vez que ya existes donde la gente busca.",
  },
] as const;

export default function DominaGooglePage() {
  const [heroDesktopOk, setHeroDesktopOk] = useState(false);
  const [heroMovilOk, setHeroMovilOk] = useState(false);
  const heroPhoto = heroDesktopOk || heroMovilOk;

  return (
    <>
      <Navbar />
      <main style={LIGHT_VARS}>
        {/* ── 1. Hero (oscuro, cine) ───────────────────────────────────── */}
        <section className="relative flex min-h-[100svh] flex-col justify-start overflow-hidden bg-allitron-base px-6 pb-12 pt-28 md:justify-center md:px-10 md:pb-16 md:pt-28 lg:px-16 xl:px-24">
          <div aria-hidden="true" className="absolute inset-x-0 bottom-0 md:hidden" style={{ aspectRatio: "1792 / 2400" }}>
            <LaunchImage
              bases={[IMG.heroMovil]}
              priority
              wrapperClassName="h-full w-full"
              imgClassName="h-full w-full object-cover"
              onStatusChange={setHeroMovilOk}
            />
            <div
              className="absolute inset-0"
              style={{
                background:
                  "linear-gradient(180deg, #101820 0%, rgba(16,24,32,0.9) 14%, rgba(16,24,32,0.45) 34%, rgba(16,24,32,0) 52%)",
              }}
            />
          </div>

          <div aria-hidden="true" className="absolute inset-0 hidden md:block">
            <LaunchImage
              bases={[IMG.heroDesktop]}
              priority
              wrapperClassName="h-full w-full"
              imgClassName="h-full w-full object-cover object-[68%_90%]"
              onStatusChange={setHeroDesktopOk}
            />
          </div>

          {heroDesktopOk && (
            <div
              aria-hidden="true"
              className="absolute inset-0 hidden md:block"
              style={{
                background:
                  "linear-gradient(90deg, rgba(16,24,32,0.82) 0%, rgba(16,24,32,0.6) 28%, rgba(16,24,32,0.18) 50%, rgba(16,24,32,0) 62%), linear-gradient(180deg, rgba(16,24,32,0.35) 0%, rgba(16,24,32,0) 22%)",
              }}
            />
          )}

          {!heroPhoto && (
            <div aria-hidden="true" className="pointer-events-none absolute inset-0">
              <div
                className="absolute inset-0"
                style={{ background: `radial-gradient(ellipse 55% 60% at 88% 12%, ${DOMINA_GOOGLE_TOKENS.accentSoft} 0%, transparent 62%)` }}
              />
            </div>
          )}

          <div className="relative z-10 mx-auto w-full max-w-[1440px]">
            <div className="max-w-[620px]">
              <motion.p
                {...reveal(0)}
                className="mb-6 font-display text-[0.58rem] font-semibold tracking-[0.4em] text-white/70"
              >
                PRESENCIA LOCAL
              </motion.p>

              <motion.h1
                {...reveal(0.08)}
                className="font-display font-black leading-[0.94] tracking-tight text-foreground"
                style={{ fontSize: "clamp(2.4rem, 5vw, 4.2rem)", textShadow: "0 2px 22px rgba(0,0,0,0.5)" }}
              >
                ANTES DE INVERTIR EN REDES, EXISTE EN GOOGLE.
              </motion.h1>

              <motion.p
                {...reveal(0.18)}
                className="mt-6 max-w-[480px] font-body text-[0.92rem] leading-[1.85] text-foreground/80"
              >
                Construimos la infraestructura que conecta tu negocio, tu
                sitio web y Google para que aparezcas cuando alguien busca
                lo que vendes en tu ciudad — el momento en que más importa.
              </motion.p>

              <motion.div {...reveal(0.28)} className="mt-10 flex flex-wrap gap-4">
                <CtaLink />
                <a
                  href="#proceso"
                  className="inline-flex items-center border border-white/[0.16] px-6 py-3 font-display text-[0.62rem] font-semibold tracking-[0.2em] text-white/85 transition-all hover:border-white/30 hover:text-white sm:px-7 sm:py-3.5"
                >
                  VER CÓMO TRABAJAMOS
                </a>
              </motion.div>
            </div>
          </div>
        </section>

        {/* ── 2. Cómo funciona la búsqueda — y dónde se pierde el cliente (claro) ── */}
        <section className="w-full bg-[var(--dg-bg)] px-8 py-28 lg:px-16 xl:px-24">
          <div className="mx-auto max-w-[1000px]">
            <span className={EYEBROW}>CÓMO FUNCIONA</span>
            <motion.h2 {...reveal(0.06)} className={H2} style={{ fontSize: "clamp(2rem, 4.2vw, 3.4rem)" }}>
              Google no muestra a todos. Muestra tres.
            </motion.h2>
            <motion.p {...reveal(0.12)} className={`mt-8 max-w-[640px] ${BODY}`}>
              Cuando alguien busca &quot;plomero cerca de mí&quot; o &quot;dentista
              en Tepic&quot;, Google no enseña una lista larga: arriba de todo
              muestra un mapa con tres negocios destacados — nombre, fotos,
              reseñas, distancia y botón de contacto, ya visibles sin hacer clic
              en nada. Esos tres compiten por un algoritmo que evalúa qué tan
              completa, activa y conectada está tu ficha con tu sitio web. Si
              esa ficha no existe o está a medias, no es que aparezcas más
              abajo — es que no compites por ese lugar en absoluto.
            </motion.p>

            <div className="mt-16 grid gap-6 sm:grid-cols-2">
              <motion.div {...reveal(0.1)} className="overflow-hidden rounded-sm border border-[var(--dg-line)] bg-[var(--dg-card)]">
                <LaunchImage
                  bases={[IMG.problemaSin]}
                  alt="Negocio sin presencia digital: nadie lo encuentra"
                  wrapperClassName="aspect-[3/2] w-full overflow-hidden"
                  imgClassName="h-full w-full object-cover"
                />
                <div className="p-8">
                  <span className="mb-4 flex items-center gap-2 font-display text-[0.6rem] font-bold tracking-[0.2em] text-[var(--dg-muted)]">
                    <X className="h-3.5 w-3.5" strokeWidth={2.5} />
                    EL ERROR MÁS COMÚN
                  </span>
                  <p className={BODY}>
                    Ficha de Google abandonada o inexistente, sin fotos, sin
                    conexión con la web, sin reseñas recientes. Para el
                    algoritmo, eso se lee como un negocio inactivo — y lo
                    entierra fuera de esos tres primeros lugares, aunque el
                    negocio esté funcionando perfecto puertas adentro.
                  </p>
                </div>
              </motion.div>
              <motion.div {...reveal(0.18)} className="overflow-hidden rounded-sm border border-[var(--dg-line)] bg-[var(--dg-card)]">
                <LaunchImage
                  bases={[IMG.problemaCon]}
                  alt="El mismo negocio con presencia digital: clientes entrando"
                  wrapperClassName="aspect-[3/2] w-full overflow-hidden"
                  imgClassName="h-full w-full object-cover"
                />
                <div className="p-8">
                  <span className="mb-4 flex items-center gap-2 font-display text-[0.6rem] font-bold tracking-[0.2em] text-[var(--dg-accent-text)]">
                    <Check className="h-3.5 w-3.5" strokeWidth={2.5} />
                    LO QUE CAMBIA
                  </span>
                  <p className="font-body text-[0.88rem] leading-[1.8] text-[var(--dg-ink)]/85">
                    Ficha completa y conectada a un sitio que carga rápido,
                    con botón directo a WhatsApp. Mejor señal para el
                    algoritmo, más opciones de entrar al paquete de tres — y
                    de ahí a un mensaje real, en el mismo momento en que la
                    persona ya estaba decidiendo.
                  </p>
                </div>
              </motion.div>
            </div>
          </div>
        </section>

        {/* ── 3. Por qué esto va antes que las redes sociales (claro) ───── */}
        <section className="w-full bg-[var(--dg-bg-alt)] px-8 py-24 lg:px-16 xl:px-24">
          <div className="mx-auto max-w-[1100px]">
            <span className={EYEBROW}>POR QUÉ ANTES QUE REDES SOCIALES</span>
            <motion.h2 {...reveal(0.06)} className={`mb-14 max-w-[700px] ${H2}`} style={{ fontSize: "clamp(1.9rem, 3.8vw, 2.8rem)" }}>
              No es contenido lo que falta. Es que te encuentren.
            </motion.h2>

            <div className="grid gap-6 lg:grid-cols-3">
              {BEFORE_SOCIAL_POINTS.map((point, i) => {
                const Icon = point.icon;
                return (
                  <motion.div key={point.title} {...reveal(0.08 * i)} className="rounded-sm border border-[var(--dg-line)] bg-[var(--dg-card)] p-8">
                    <div className="mb-5 flex h-10 w-10 items-center justify-center rounded-full" style={{ background: `${ACCENT}1f` }}>
                      <Icon className="h-4 w-4" style={{ color: L.accentText }} strokeWidth={2.2} />
                    </div>
                    <h3 className="mb-3 font-display text-[1rem] font-black leading-tight text-[var(--dg-ink)]">{point.title}</h3>
                    <p className={BODY}>{point.text}</p>
                  </motion.div>
                );
              })}
            </div>
          </div>
        </section>

        {/* ── 4. Así te acompañamos — quién hace el trabajo técnico (claro) ── */}
        <section className="w-full bg-[var(--dg-bg)] px-8 py-24 lg:px-16 xl:px-24">
          <div className="mx-auto flex max-w-[1100px] flex-col items-center gap-12 lg:flex-row lg:gap-16">
            <motion.div {...reveal(0)} className="relative w-full lg:w-[46%]">
              <LaunchImage
                bases={[IMG.historia]}
                alt="Lups y Alli trabajando juntos"
                wrapperClassName="aspect-[3/2] w-full overflow-hidden rounded-sm"
                imgClassName="h-full w-full object-cover"
              />
            </motion.div>
            <div className="flex-1">
              <motion.h2 {...reveal(0.06)} className={H2} style={{ fontSize: "clamp(1.8rem, 3.4vw, 2.6rem)" }}>
                No te dejamos con un manual. Lo instalamos nosotros.
              </motion.h2>
              <div className="mt-8 flex flex-col gap-5">
                <motion.p {...reveal(0.12)} className={BODY}>
                  Nos compartes la información, fotos y textos de tu negocio.
                  Nosotros construimos el sitio, dejamos tu ficha de Google
                  optimizada y la conectamos con Maps y con tu web — no es
                  una plantilla que llenas tú solo.
                </motion.p>
                <motion.p {...reveal(0.18)} className={BODY}>
                  Antes de entregarte nada, lo validamos técnicamente: que la
                  ficha esté completa, que el sitio cargue rápido, que el
                  botón de WhatsApp funcione. Alli te acompaña con dudas en
                  el camino — la parte técnica queda instalada y probada, no
                  a medias.
                </motion.p>
              </div>
            </div>
          </div>
        </section>

        {/* ── 5. Qué incluye (claro) ───────────────────────────────────── */}
        <section className="w-full bg-[var(--dg-bg-alt)] px-8 py-24 lg:px-16 xl:px-24">
          <div className="mx-auto max-w-[1100px]">
            <span className={EYEBROW}>QUÉ INCLUYE</span>
            <motion.h2 {...reveal(0.06)} className={`mb-14 max-w-[640px] ${H2}`} style={{ fontSize: "clamp(2rem, 4vw, 3rem)" }}>
              La infraestructura completa. No solo una página.
            </motion.h2>

            <div className="grid gap-x-10 gap-y-7 sm:grid-cols-2">
              {DG_INCLUDES.map((item, i) => {
                const Icon = INCLUDE_ICONS[i] ?? CheckCircle2;
                return (
                  <motion.div key={item} {...reveal(0.03 * i)} className="flex items-start gap-4">
                    <div
                      className="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full"
                      style={{ background: `${ACCENT}1f` }}
                    >
                      <Icon className="h-3.5 w-3.5" style={{ color: L.accentText }} strokeWidth={2.2} />
                    </div>
                    <p className="pt-1 font-body text-[0.9rem] leading-[1.6] text-[var(--dg-ink)]">{item}</p>
                  </motion.div>
                );
              })}
            </div>

            <motion.div {...reveal(0.1)} className="mt-12">
              <CtaLink />
            </motion.div>
          </div>
        </section>

        {/* ── 6. Cómo trabajamos: 4 fases con fotos (claro) ────────────── */}
        <section id="proceso" className="w-full bg-[var(--dg-bg)] px-8 py-24 lg:px-16 xl:px-24">
          <div className="mx-auto max-w-[1200px]">
            <span className={EYEBROW}>CÓMO TRABAJAMOS</span>
            <motion.h2 {...reveal(0.06)} className={`mb-16 max-w-[600px] ${H2}`} style={{ fontSize: "clamp(2rem, 4vw, 3.2rem)" }}>
              Método propio. Cuatro fases, once pasos.
            </motion.h2>

            <div className="relative flex flex-col gap-6">
              {LOCAL_METHODOLOGY.map((phase, i) => (
                <motion.div
                  key={phase.id}
                  {...reveal(0.06 * i)}
                  className="grid items-center gap-8 rounded-sm border border-[var(--dg-line)] bg-[var(--dg-card)] p-6 shadow-[0_18px_50px_rgba(26,22,20,0.08)] lg:grid-cols-[0.95fr_1.05fr] lg:gap-14 lg:p-10"
                >
                  <div className={i % 2 === 1 ? "lg:order-2" : ""}>
                    <LaunchImage
                      bases={[PHASE_BASES[i]]}
                      fallbackSrc={PHASE_FALLBACKS[i]}
                      alt={`Domina Google — fase ${phase.label}`}
                      wrapperClassName="aspect-[4/3] w-full overflow-hidden rounded-sm"
                      imgClassName="h-full w-full object-cover transition-transform duration-700 hover:scale-[1.03]"
                    />
                  </div>
                  <div className={i % 2 === 1 ? "lg:order-1" : ""}>
                    <span className="mb-3 block font-display text-[0.5rem] font-bold tracking-[0.3em]" style={{ color: L.accentText }}>
                      {phase.phase}
                    </span>
                    <h3 className="mb-5 font-display text-[1.4rem] font-black text-[var(--dg-ink)]">{phase.label}</h3>
                    <div className="flex flex-col gap-4">
                      {phase.steps.map((step) => (
                        <div key={step.number} className="flex gap-3">
                          <span className="font-display text-[0.62rem] font-bold tabular-nums text-[var(--dg-muted)]/60">{step.number}</span>
                          <div>
                            <span className="font-display text-[0.72rem] font-bold tracking-wide text-[var(--dg-ink)]">{step.label}</span>
                            <p className="mt-1 font-body text-[0.82rem] leading-[1.65] text-[var(--dg-muted)]">{step.description}</p>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </motion.div>
              ))}
            </div>
          </div>
        </section>

        {/* ── 7. Qué NO incluye — transparencia (claro) ────────────────── */}
        <section className="w-full bg-[var(--dg-bg-alt)] px-8 py-24 lg:px-16 xl:px-24">
          <div className="mx-auto max-w-[900px]">
            <span className={EYEBROW}>PARA SER CLAROS</span>
            <motion.h2 {...reveal(0.06)} className={`mb-12 max-w-[600px] ${H2}`} style={{ fontSize: "clamp(1.7rem, 3.4vw, 2.4rem)" }}>
              Esto no incluye — y preferimos decírtelo ahora.
            </motion.h2>

            <div className="grid gap-4 sm:grid-cols-2">
              {DG_EXCLUDES.map((item, i) => (
                <motion.div key={item} {...reveal(0.03 * i)} className="flex items-start gap-3">
                  <X className="mt-1 h-3.5 w-3.5 shrink-0 text-[var(--dg-muted)]/70" strokeWidth={2.5} />
                  <p className={BODY}>{item}</p>
                </motion.div>
              ))}
            </div>
          </div>
        </section>

        {/* ── 8. Garantía (claro) ──────────────────────────────────────── */}
        <section className="w-full bg-[var(--dg-bg)] px-8 py-24 lg:px-16 xl:px-24">
          <div className="mx-auto max-w-[900px]">
            <span className={EYEBROW}>GARANTÍA</span>
            <motion.h2 {...reveal(0.06)} className={`mb-12 ${H2}`} style={{ fontSize: "clamp(1.8rem, 3.6vw, 2.6rem)" }}>
              Trabajamos para que compitas por las posiciones más visibles.
            </motion.h2>

            <div className="grid gap-px overflow-hidden bg-[var(--dg-line)] sm:grid-cols-2">
              <motion.div {...reveal(0.08)} className="bg-[var(--dg-card)] p-8">
                <span
                  className="mb-4 flex items-center gap-2 font-display text-[0.6rem] font-bold tracking-[0.2em]"
                  style={{ color: L.accentText }}
                >
                  <Check className="h-3.5 w-3.5" strokeWidth={2.5} />
                  GARANTIZAMOS
                </span>
                <p className={BODY}>
                  Entrega técnica en 7 días hábiles desde que recibimos tu
                  información completa: infraestructura web en línea, ficha
                  de Google optimizada y ruta directa a WhatsApp operativa.
                </p>
              </motion.div>
              <motion.div {...reveal(0.16)} className="bg-[var(--dg-card)] p-8">
                <span className="mb-4 flex items-center gap-2 font-display text-[0.6rem] font-bold tracking-[0.2em] text-[var(--dg-muted)]">
                  <X className="h-3.5 w-3.5" strokeWidth={2.5} />
                  NO GARANTIZAMOS
                </span>
                <p className={BODY}>
                  Posición #1 absoluta, resultados si no generas reseñas o
                  no respondes a tus prospectos, ni cambios del algoritmo de
                  Google. Nadie honesto puede prometerte eso.
                </p>
              </motion.div>
            </div>
          </div>
        </section>

        {/* ── 9. Para quién es + requisitos (claro) ────────────────────── */}
        <section className="w-full bg-[var(--dg-bg-alt)] px-8 py-24 lg:px-16 xl:px-24">
          <div className="mx-auto max-w-[1100px]">
            <span className={EYEBROW}>PARA QUIÉN ES</span>
            <motion.h2
              {...reveal(0.06)}
              className={`mb-12 max-w-[600px] ${H2}`}
              style={{ fontSize: "clamp(1.9rem, 3.8vw, 2.8rem)" }}
            >
              El perfil que mejor le saca provecho a esto.
            </motion.h2>

            <div className="flex flex-wrap gap-3">
              {DG_IDEAL_CLIENT.map((item, i) => (
                <motion.span
                  key={item}
                  {...reveal(0.02 * i)}
                  className="border px-4 py-2 font-body text-[0.8rem] text-[var(--dg-ink)]"
                  style={{ borderColor: "var(--dg-line)" }}
                >
                  {item}
                </motion.span>
              ))}
            </div>

            <motion.div {...reveal(0.2)} className="mt-12 border-t border-[var(--dg-line)] pt-8">
              <span className="mb-4 block font-display text-[0.55rem] font-bold tracking-[0.3em] text-[var(--dg-muted)]">
                REQUISITOS
              </span>
              <div className="flex flex-wrap gap-x-10 gap-y-3">
                {DG_REQUIREMENTS.map((req) => (
                  <div key={req} className="flex items-center gap-2">
                    <Check className="h-3.5 w-3.5" style={{ color: L.accentText }} strokeWidth={2.5} />
                    <span className="font-body text-[0.85rem] text-[var(--dg-muted)]">{req}</span>
                  </div>
                ))}
              </div>
            </motion.div>
          </div>
        </section>

        {/* ── 10. CTA final (oscuro, cine) ─────────────────────────────── */}
        <section className="relative w-full overflow-hidden bg-allitron-base md:min-h-[560px] lg:min-h-[min(46vw,700px)] xl:min-h-[min(44vw,840px)]">
          <div aria-hidden="true" className="relative h-[280px] w-full md:hidden">
            <LaunchImage
              bases={[IMG.ctaFinal]}
              wrapperClassName="h-full w-full"
              imgClassName="h-full w-full object-cover object-[78%_center]"
            />
            <div
              className="absolute inset-0"
              style={{ background: "linear-gradient(180deg, rgba(16,24,32,0.35) 0%, rgba(16,24,32,0) 30%, rgba(16,24,32,0.7) 80%, #101820 100%)" }}
            />
          </div>

          <div aria-hidden="true" className="absolute inset-0 hidden md:block">
            <LaunchImage
              bases={[IMG.ctaFinal]}
              wrapperClassName="h-full w-full"
              imgClassName="h-full w-full object-cover object-[center_72%] xl:object-[center_50%]"
              fallback={
                <div
                  className="absolute inset-0"
                  style={{ background: `radial-gradient(ellipse 50% 50% at 50% 0%, ${DOMINA_GOOGLE_TOKENS.accentSoft} 0%, transparent 65%)` }}
                />
              }
            />
            <div
              className="absolute inset-0"
              style={{
                background:
                  "linear-gradient(180deg, rgba(16,24,32,0.78) 0%, rgba(16,24,32,0.4) 34%, rgba(16,24,32,0) 58%), linear-gradient(90deg, rgba(16,24,32,0.5) 0%, rgba(16,24,32,0) 52%)",
              }}
            />
          </div>

          <div className="relative z-10 mx-auto max-w-[1200px] px-6 pb-24 pt-2 md:px-10 md:pb-16 md:pt-16 lg:px-16 xl:px-24">
            <div className="max-w-[520px] text-center md:text-left">
              <motion.h2
                {...reveal(0.04)}
                className="mb-7 font-display font-black leading-[0.98] tracking-tight text-foreground"
                style={{ fontSize: "clamp(1.9rem, 3.8vw, 2.8rem)", textShadow: "0 2px 22px rgba(0,0,0,0.5)" }}
              >
                ¿LISTO PARA QUE TE ENCUENTREN?
              </motion.h2>
              <motion.div {...reveal(0.1)} className="flex justify-center md:justify-start">
                <CtaLink large />
              </motion.div>
            </div>
          </div>
        </section>
      </main>
      <Footer />
    </>
  );
}
